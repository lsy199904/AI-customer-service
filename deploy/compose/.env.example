# ============================================================================
# titu-assistant Docker Compose 配置模板 —— deploy/k8s/dev 的 10-configmap.yml
# 与 20-secret.yml 的合并等价物（外加镜像/端口等 compose 编排参数）。
#
# 用法：cp .env.example .env 后按需修改；.env 已被 .gitignore 忽略，不入库。
# 「应用运行配置」各键名与 K8s ConfigMap/Secret 一一对应，由 env_file 注入
# assistant 与 milvus-init 容器；db-migrate 另从中取 Flyway 占位符（compose.yaml）。
#
# 注意：下方密钥值与 deploy/k8s/dev/20-secret.yml 同源，仅限 dev 使用；
# 任何对外环境必须全部轮换（生成命令见各键注释）。
# ============================================================================

# ---- 项目与端口（00-namespace / compose 宿主机入口端口；K8s 入口走 Ingress）----
TZ=Asia/Shanghai
APP_NODE_PORT=30201

# ---- 镜像引用（60-deployment / 40-job / 50-job 的 image 字段）----
# 两个镜像用同一 tag 配套构建（build.sh），但镜像名不同：app 镜像不含 Flyway，
# db-migrate 镜像不含应用代码，两者不可混用。
ASSISTANT_IMAGE=harbor.rd.dsi/smarttitu/smarttitu-assistant:v1.0.0-20261120
DB_MIGRATE_IMAGE=harbor.rd.dsi/smarttitu/db-migrate:v1.0.0-20261120

# 本地构建镜像（deploy/docker/{app,db-migrate}/build.sh）可用的换源参数（同名环境变量），
# 构建完成后把产物 tag 更新到上面两个镜像引用：
# PYTHON_IMAGE=python:3.12-slim-bookworm
# UV_IMAGE=ghcr.io/astral-sh/uv:0.9.5
# APT_MIRROR=mirrors.huaweicloud.com
# FLYWAY_IMAGE=flyway/flyway:11.20.3-alpine

# ---- PostgreSQL（infra/postgres CNPG postgres-14-cluster 的单实例等价）----
POSTGRES_IMAGE=postgres:14-bookworm
POSTGRES_DB=smarttitu_assistant
POSTGRES_USER=smarttitu_assistant
# 密码含 # 必须加引号；DATABASE_URL 由 compose.yaml 自动拼接为本库地址
POSTGRES_PASSWORD="dasbjcehfi#*jdsadh2934xx"
# 指向外部 PostgreSQL 时整行覆盖（密码需按 URL 编码，如 # -> %23）：
# DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# ---- Milvus 基础设施（infra/milvus operator cluster 的 standalone 等价）----
# 与 docker.io 同 tag 的对应镜像：milvusdb/milvus:v2.6.4、milvusdb/etcd:3.5.25-r1、
# minio/minio:RELEASE.2024-12-18T13-15-44Z；无内网 Harbor 时自行换源。
MILVUS_IMAGE=harbor.rd.dsi/docker.io/milvusdb/milvus:v2.6.4
ETCD_IMAGE=harbor.rd.dsi/docker.io/milvusdb/etcd:3.5.25-r1
MINIO_IMAGE=harbor.rd.dsi/docker.io/minio/minio:RELEASE.2024-12-18T13-15-44Z
# MinIO 凭证固定 minioadmin/minioadmin（与 Milvus 内置默认一致），见 compose.yaml。

# ============================================================================
# 应用运行配置 = 10-configmap.yml + 20-secret.yml
# ============================================================================

# ---- 应用运行 ----
HOST=0.0.0.0
PORT=8201
APP_WORKERS=1

# ---- 认证与部署标识 ----
# 【必填】App 与初始化 Job 须一致，首次生成后不变：python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
DEPLOYMENT_ID=PVkfazVwwNC-ZiOtDIBiS1_BvEK--HZU

# ---- Milvus ----
VECTOR_BACKEND=milvus
MILVUS_URI=http://milvus:19530
# 【必填】含协议与端口；compose 指向栈内 milvus 服务（K8s 里是
# http://milvus-26-milvus.milvus.svc.cluster.local:19530）。该值同时作为
# Flyway 占位符 FLYWAY_PLACEHOLDERS_MILVUS_URI 传入迁移 Job，两处必须一致。
MILVUS_DATABASE=default
MILVUS_COLLECTION=smarttitu_knowledge
MILVUS_INDEX_TYPE=HNSW

# ---- LLM（外部API）----
ANSWER_MODE=llm
MODEL_BASE_URL=https://api.siliconflow.cn/v1
MODEL_NAME=Qwen/Qwen3-32B
MODEL_MAX_TOKENS=2048
MODEL_DISABLE_THINKING=true
MODEL_THINKING_FORMAT=enable_thinking

# ---- Embedding ----
EMBEDDING_PROVIDER=openai
EMBEDDING_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=v1
EMBEDDING_TIMEOUT=30

# ---- Rerank ----
RERANK_ENABLED=true
RERANK_URL=https://api.siliconflow.cn/v1/rerank
RERANK_MODEL=Qwen/Qwen3-Reranker-4B
RERANK_TIMEOUT=60

# ---- 检索与模型网络 ----
RETRIEVAL_BACKEND=semantic
MODEL_HTTP_ORIGINS=http://10.180.158.23:4001
SEMANTIC_MIN_SIMILARITY=0.60
RERANK_MIN_SCORE=0
RAG_TOP_K=12
RAG_CONTEXT_K=3
RETRIEVAL_TIMEOUT_SECONDS=60

# ---- 匿名身份与前端接入 ----
ANONYMOUS_WIDGET_ENABLED=true
ANONYMOUS_COOKIE_NAME=smarttitu_ext_40e7b3eaf736
# K8s dev 与 compose 目前都走 IP + HTTP（false）；任一侧上 HTTPS 时要改回 true
ANONYMOUS_COOKIE_SECURE=false
# FRAME_ORIGINS=            # 允许嵌入iframe的业务来源，逗号分隔
# CORS_ORIGINS=             # 前端跨域直调API时才需要

# ---- 会话与限流 ----
SESSION_RETENTION_DAYS=7
SESSION_CONTEXT_ROUNDS=20
SESSION_IDLE_SECONDS=1800
SESSION_CLEANUP_INTERVAL_SECONDS=300
TENANT_MESSAGES_PER_MINUTE=20
GLOBAL_RAG_QUESTIONS_PER_DAY=1000

# ---- 日志 ----
LOG_TIMEZONE=Asia/Shanghai
LOG_RETENTION_DAYS=30
LOG_DEBUG_CONTENT=true
LOG_DEBUG_RETENTION_DAYS=7
LOG_TRACE_DETAIL=compact

# ---- 知识图片与外链 ----
PDF_MEDIA_ENABLED=true
CUSTOMER_LINK_HOSTS=www.smarttitu.cn,smarttitu.cn,console.smarttitu.cn,doc.smarttitu.cn
SUPPORT_QR_URL=

# ---- 敏感配置（= 20-secret.yml；生产环境全部轮换）----
# 【必填】python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_SECRET=WBJmMBlyjZ6MexY37guT223kOIuQhsdwZn1C0k6uWOjczpv8CzZ8_Iq03PU-5pOc
# 【必填】python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
OPERATIONS_TOKEN=Ar-U58GsYssf53PeFCBppO6xmJ-sp9a_Ab8iObBzE4Y
# 【必填】需允许建集合/索引、写入及检索
MILVUS_TOKEN=xxx
# 【必填】LLM / Embedding / Rerank 供应商密钥
MODEL_API_KEY=sk-xxx
EMBEDDING_API_KEY=sk-xxx
RERANK_API_KEY=sk-xxx

# ---- 容器内文件路径（与镜像内布局一致，勿改）----
KNOWLEDGE_SOURCE_DIR=/srv/assistant/knowledge_sources
MEDIA_PATH=/srv/assistant/data/media.json
PDF_MEDIA_DIR=/srv/assistant/var/pdf_media
LOG_DIR=/srv/assistant/var/logs
DATABASE_PATH=/srv/assistant/var/assistant.db
RAG_INDEX_PATH=/srv/assistant/var/rag.sqlite3

# 本次整合新增配置
# 门户登录账号接入，默认关闭；开启后由可信门户提供 userId/userName。
WIDGET_TRUST_ACCOUNT_PARAMS=false
WIDGET_ACCOUNT_TENANT=smarttitu_portal
# 输入理解模型单次调用超时（秒），不代表整轮问答超时。
QUERY_CONTEXT_TIMEOUT_SECONDS=30
# 用户仍只能查看 SESSION_RETENTION_DAYS 范围内的历史；0 关闭数据库自动清理。
SESSION_PURGE_AFTER_DAYS=0
