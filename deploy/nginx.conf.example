# 替换域名、证书路径；部署于应用同一主机。先执行 nginx -t 再重载。
server {
    listen 80;
    server_name assistant.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name assistant.example.com;
    ssl_certificate /etc/nginx/certs/assistant/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/assistant/privkey.pem;
    client_max_body_size 16k;
    location /smart-bot/ {
        # 无尾斜杠：保留/smart-bot前缀。外部统一使用此路径。
        proxy_pass http://127.0.0.1:8200;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 240s;
        proxy_send_timeout 240s;
    }
    # 旧Demo不开放。匿名接入检查页在/smart-bot/widget/anonymous-demo。
    location / { return 404; }
}
