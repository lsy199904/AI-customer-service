# 非敏感配置。格式为 KEY=VALUE，值不要加引号（引号会被当成值的一部分）。
# 各环境差异不要写在这里，放到 overlays/*/config-patch.yaml 覆盖。

# ---- 监听 ----
# 应用读的是 HOST / PORT（app/server.py 的 main()），不是 compose 的 V3_HOST/V3_PORT
HOST=0.0.0.0
PORT=8200
# 单容器单进程，靠副本数扩容
APP_WORKERS=1

# ---- 模型服务 ----
# 【必读】Settings.validate() 只接受 https，或 http + 私网 IP / localhost。
# Service 短名（http://llm:8000）和 FQDN 都会让 Pod 起不来。两条路：
#   A. 模型用 HTTPS 域名（推荐），下面 http 项全改 https，且无需 MODEL_HTTP_ORIGINS
#   B. 给模型 Service 固定 clusterIP，此处写 IP 字面量
MODEL_BASE_URL=http://10.96.0.20:8000/v1
MODEL_NAME=Qwen/Qwen3-32B
MODEL_MAX_TOKENS=2048
MODEL_DISABLE_THINKING=true
# 仅 http 需要，格式 协议://IP:端口，不带路径；必须与上面地址的 scheme://netloc 一致
MODEL_HTTP_ORIGINS=http://10.96.0.20:8000,http://10.96.0.21:8000

EMBEDDING_PROVIDER=openai
EMBEDDING_URL=http://10.96.0.21:8000/v1/embeddings
EMBEDDING_MODEL=bge-m3
# 换模型或切分方式必须改版本号并 ingest --rebuild，否则 collection 名不变
EMBEDDING_REVISION=v1
RERANK_ENABLED=true
RERANK_URL=http://10.96.0.21:8000/v1/rerank
RERANK_MODEL=Qwen3-Reranker-4B

# ---- 检索策略 ----
ANSWER_MODE=llm
RETRIEVAL_BACKEND=semantic
SEMANTIC_MIN_SIMILARITY=0.60
RERANK_MIN_SCORE=0.60
RAG_TOP_K=12
RAG_CONTEXT_K=3
RETRIEVAL_TIMEOUT_SECONDS=15
EMBEDDING_TIMEOUT=30
RERANK_TIMEOUT=30

# ---- 向量库（Milvus 地址不做私网校验，可用集群内 FQDN）----
VECTOR_BACKEND=milvus
MILVUS_URI=http://milvus.data.svc.cluster.local:19530
# 【重要】最终 collection 名 = 本值 + '_' + embedding fingerprint 前 16 位。
# 三个环境若共用同一个 Milvus 实例且用同一个 embedding 模型，fingerprint 相同，
# collection 名就会撞在一起、互相污染。所以每个 overlay 必须覆盖本值，
# 见 overlays/*/config-patch.yaml。
MILVUS_COLLECTION=smarttitu_knowledge

# ---- 匿名入口 ----
ANONYMOUS_WIDGET_ENABLED=true
# 走 HTTPS 网关必须 true，否则 Cookie 不带 Secure，跨站 iframe 会被浏览器丢弃
ANONYMOUS_COOKIE_SECURE=true
FRAME_ORIGINS=https://portal.example.com
CORS_ORIGINS=

# ---- 会话与限流 ----
SESSION_RETENTION_DAYS=7
SESSION_CONTEXT_ROUNDS=20
SESSION_IDLE_SECONDS=1800
# 清理循环每轮都会写库。数据库是 1C2G 时 300 秒一次过于频繁，
# 调到 30 分钟；对 7 天保留策略没有实质影响。
SESSION_CLEANUP_INTERVAL_SECONDS=1800
# 租户级滚动 60 秒窗口，计数在 PostgreSQL，多副本天然一致
TENANT_MESSAGES_PER_MINUTE=20

# ---- 路径 ----
LOG_DIR=/ai_customer/var/logs
PDF_MEDIA_DIR=/ai_customer/var/pdf_media
# 成本用量报表，默认值是相对路径 var/cost-reports，必须显式改成绝对路径，
# 否则会落到只读根文件系统上（save_request 静默失败，问答不受影响但报表全丢）
COST_REPORT_DIR=/ai_customer/var/cost-reports
MEDIA_PATH=/ai_customer/data/media.json
KNOWLEDGE_SOURCE_DIR=/ai_customer/knowledge_sources
# DB 模式下只用于 mkdir 兜底，不会被真正读写
DATABASE_PATH=/ai_customer/var/assistant.db
RAG_INDEX_PATH=/ai_customer/var/rag.sqlite3

# ---- 日志 ----
LOG_TIMEZONE=Asia/Shanghai
LOG_RETENTION_DAYS=30
LOG_DEBUG_CONTENT=false
LOG_DEBUG_RETENTION_DAYS=3
LOG_TRACE_DETAIL=compact

PDF_MEDIA_ENABLED=true
CUSTOMER_LINK_HOSTS=www.smarttitu.cn,smarttitu.cn,console.smarttitu.cn,doc.smarttitu.cn
SUPPORT_QR_URL=
