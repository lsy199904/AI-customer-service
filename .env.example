# 使用python3 manage.py读取.env,不需要source;容器由env_file读取
# 参数说明 AUTH_SECRET：客服身份凭证签名密钥，至少32字节；仅后端保存，变更会使旧凭证失效并改变日志匿名标识。
AUTH_SECRET=
# 客户真实问答:llm;extractive仅作运维对照,不会调用聊天模型
# 参数说明 ANSWER_MODE：回答模式：llm调用聊天模型；extractive直接返回知识正文，用于对照排查。
ANSWER_MODE=llm
# 参数说明 RETRIEVAL_BACKEND：知识检索方式：semantic语义混合检索；lexical传统本地关键词检索。
RETRIEVAL_BACKEND=semantic
# 参数说明 MODEL_BASE_URL：聊天模型服务基础地址，一般以/v1结尾，不填写完整chat/completions路径。
MODEL_BASE_URL=http://10.180.158.23:18080/v1
# 参数说明 MODEL_API_KEY：聊天模型接口访问密钥；保密，是否可使用占位值取决于模型服务鉴权。
MODEL_API_KEY=not-empty
# 参数说明 MODEL_NAME：聊天模型名称，必须与服务端对外暴露的模型名称一致。
MODEL_NAME=Qwen/Qwen3-32B
# 按实际服务地址调整,只填写协议/主机/端口,不带接口路径
# 参数说明 MODEL_HTTP_ORIGINS：允许访问的模型HTTP服务来源，逗号分隔；填写协议、主机、端口，不带接口路径。
MODEL_HTTP_ORIGINS=http://10.180.158.23:18080,http://127.0.0.1:11434,http://172.19.0.2:8001

# 参数说明 EMBEDDING_PROVIDER：向量接口协议：ollama或openai，需与Embedding服务匹配。
EMBEDDING_PROVIDER=ollama
# 参数说明 EMBEDDING_URL：文本向量化接口的完整地址，用于入库和在线检索。
EMBEDDING_URL=http://127.0.0.1:11434/api/embed
# 参数说明 EMBEDDING_MODEL：Embedding模型名称，例如bge-m3:latest。
EMBEDDING_MODEL=bge-m3:latest
# 参数说明 EMBEDDING_API_KEY：Embedding接口访问密钥；无鉴权时可按服务要求留空。
EMBEDDING_API_KEY=
# 同名模型权重或处理方式变化时更新该版本并ingest --rebuild
# 参数说明 EMBEDDING_REVISION：Embedding权重或处理方式版本；变化后需更新并执行ingest --rebuild。
EMBEDDING_REVISION=v1
# 参数说明 RERANK_ENABLED：是否启用候选重排：true启用，false关闭；关闭后Rerank门槛不参与筛选。
RERANK_ENABLED=true
# 参数说明 RERANK_URL：重排接口完整地址，例如/v1/rerank。
RERANK_URL=http://172.19.0.2:8001/v1/rerank
# 参数说明 RERANK_MODEL：重排模型名称，必须与重排服务一致。
RERANK_MODEL=Qwen3-Reranker-4B
# 参数说明 RERANK_API_KEY：重排接口访问密钥，无鉴权时可按服务要求留空。
RERANK_API_KEY=
# 起始参数需要用真实问题校准；重排门槛会过滤候选，分数不是准确率。
# 参数说明 SEMANTIC_MIN_SIMILARITY：向量召回相似度门槛，默认0.75；不等于回答准确率。
SEMANTIC_MIN_SIMILARITY=0.75
# 参数说明 RERANK_MIN_SCORE：启用重排时的最低得分门槛，默认0.6；低于此值的候选被过滤。
RERANK_MIN_SCORE=0.6
# 参数说明 RAG_TOP_K：每路召回上限，默认12；两路融合去重后最多为该值的2倍。
RAG_TOP_K=12
# 参数说明 RAG_CONTEXT_K：交给回答模型的知识片段上限，默认3；不保证每次取满，不能大于RAG_TOP_K。
RAG_CONTEXT_K=3
# 默认路径:knowledge_sources/ 和 var/rag.sqlite3
# KNOWLEDGE_SOURCE_DIR=
# RAG_INDEX_PATH=

# iframe父页面允许来源，逗号分隔，准确到协议和端口；无尾部斜杠
# 示例 FRAME_ORIGINS=https://console.example.com,http://localhost:3000
# 参数说明 FRAME_ORIGINS：允许嵌入客服iframe的父页面来源，逗号分隔，准确到协议、主机与端口。
FRAME_ORIGINS=
# 参数说明 CORS_ORIGINS：允许跨域调用客服接口的浏览器页面来源，逗号分隔；与iframe来源限制用途不同。
CORS_ORIGINS=
# 当前没有真实企业微信二维码,保持空白
# 参数说明 SUPPORT_QR_URL：人工联系企业微信二维码地址，未配置时留空；不会自动连接真人客服。
SUPPORT_QR_URL=
# 参数说明 SOURCE_BASE_URL：历史配置：来源文档基础URL；当前来源面板已取消原文下载与外链入口。
SOURCE_BASE_URL=
# 仅本机访问用127.0.0.1；公司内网直接访问用0.0.0.0
# 参数说明 HOST：客服监听地址：127.0.0.1仅本机访问；0.0.0.0监听全部网卡，访问范围由网络策略决定。
HOST=127.0.0.1
# 参数说明 PORT：客服HTTP监听端口，主版本通常8000，独立v2部署通常8100。
PORT=8000

# Enterprise deployment: use sh scripts/enterprise.sh configure to generate locally.
# Empty DATABASE_URL + VECTOR_BACKEND=sqlite preserves standalone compatibility.
# 参数说明 DATABASE_URL：客服PostgreSQL连接串，包含地址、端口、数据库与账号密码；保密。
DATABASE_URL=
# 参数说明 VECTOR_BACKEND：向量存储后端：milvus或sqlite；企业部署使用milvus。
VECTOR_BACKEND=sqlite
# 参数说明 MILVUS_URI：Milvus连接地址，通常http://127.0.0.1:19530。
MILVUS_URI=http://127.0.0.1:19530
# 参数说明 MILVUS_TOKEN：Milvus鉴权凭证，通常为用户名:密码；保密。
MILVUS_TOKEN=
# 参数说明 MILVUS_COLLECTION：Milvus集合名称；不同环境是否共享需明确，勿随意更改。
MILVUS_COLLECTION=smarttitu_knowledge
# configure generates PostgreSQL/MinIO/Milvus credentials and OPERATIONS_TOKEN.
# 参数说明 OPERATIONS_TOKEN：运维接口访问密钥，用于受保护的运行配置查询；与普通用户凭证不同。
OPERATIONS_TOKEN=
# 参数说明 APP_WORKERS：Uvicorn进程数，代码允许1至4，默认1；增加前需评估模型并发容量。
APP_WORKERS=1
# Query timeouts; no automatic retries to avoid amplifying overload.
# 参数说明 EMBEDDING_TIMEOUT：单次Embedding调用超时，单位秒，默认30；在线检索同时受总预算限制。
EMBEDDING_TIMEOUT=30
# 参数说明 RERANK_TIMEOUT：单次重排调用超时，单位秒，默认30；在线检索同时受总预算限制。
RERANK_TIMEOUT=30
# 参数说明 MODEL_MAX_TOKENS：聊天模型单次最大生成Token数，默认2048；不是中文字符数。
MODEL_MAX_TOKENS=2048
# Qwen3 chat-template option; set false if your model server does not support it.
# 参数说明 MODEL_DISABLE_THINKING：Qwen3关闭思考输出选项，默认true；需模型服务支持，不是关闭处理日志。
MODEL_DISABLE_THINKING=true

# 历史保留7天；20轮为模型上下文上限，不限制继续聊天
# 参数说明 SESSION_RETENTION_DAYS：页面历史消息及会话保留天数，默认7，允许1至365；已清理数据不能恢复。
SESSION_RETENTION_DAYS=7
# 参数说明 SESSION_CONTEXT_ROUNDS：模型最多参考的最近问答轮数，默认20，允许1至1000；不是页面历史条数上限。
SESSION_CONTEXT_ROUNDS=20
# 参数说明 SESSION_IDLE_SECONDS：会话空闲阈值，单位秒，默认1800；超时后不再携带此前上下文，历史仍按保留期可查。
SESSION_IDLE_SECONDS=1800
# 参数说明 SESSION_CLEANUP_INTERVAL_SECONDS：后台清理过期会话和检查点的检查间隔，单位秒，默认300。
SESSION_CLEANUP_INTERVAL_SECONDS=300
# 同一企业全部用户共享滚动60秒窗口；会话创建不计入
# 参数说明 TENANT_MESSAGES_PER_MINUTE：同企业所有账号共用的滚动60秒提问额度，默认20；匿名测试用户共用测试企业额度。
TENANT_MESSAGES_PER_MINUTE=20
# 整条检索（含Embedding、向量召回和重排）的总预算，不含LLM生成
# 参数说明 RETRIEVAL_TIMEOUT_SECONDS：整条在线检索总预算，包含Embedding、向量查询及重排，单位秒，默认15；不包含回答生成。
RETRIEVAL_TIMEOUT_SECONDS=15

# Structured operational logs; defaults are relative to the application project.
# LOG_DIR=/ai_customer/var/logs
# 参数说明 LOG_TIMEZONE：日志日期和时间使用的时区，默认Asia/Shanghai。
LOG_TIMEZONE=Asia/Shanghai
# 参数说明 LOG_RETENTION_DAYS：普通运行日志及不含正文的问答摘要保留天数，默认30，允许1至365。
LOG_RETENTION_DAYS=30
# Temporary troubleshooting only: bounded question/evidence/model/answer snapshots.
# 会话调试日志按月/企业/用户/会话保存；默认关闭完整正文。
# 参数说明 LOG_DEBUG_CONTENT：是否记录完整问题、知识依据、模型输入输出等排障内容；true开启，生产按需启用。
LOG_DEBUG_CONTENT=false
# 参数说明 LOG_DEBUG_RETENTION_DAYS：包含完整正文的排障记录保留天数，默认3，允许1至30；与普通日志保留期独立。
LOG_DEBUG_RETENTION_DAYS=3

# 仅分享测试页时开启；正式平台登录对接保持false
# 参数说明 DEMO_AUTO_LOGIN：匿名测试页是否自动发放测试凭证；true免手填，正式平台账号接入后应关闭。
DEMO_AUTO_LOGIN=false
