# 推荐使用python3 manage.py自动读取.env；容器通过env_file读取
# AUTH_SECRET 必填,生成后只保存在可信后端;至少32字节
AUTH_SECRET=
ANSWER_MODE=extractive
# 真正模型生成时改为 llm 并配置以下参数;实际模型ID以控制台为准
MODEL_BASE_URL=https://api.smarttitu.cn/v1
MODEL_API_KEY=
MODEL_NAME=
# 逗号分隔的前端来源,本地纯接口测试可留空
CORS_ORIGINS=
# 企业微信客服二维码的HTTPS图片URL,未配置时返回null
SUPPORT_QR_URL=
# 可选:原文档的受控HTTPS目录,没有时只提供已认证的知识条目链接
SOURCE_BASE_URL=
HOST=127.0.0.1
PORT=8000
