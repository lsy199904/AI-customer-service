# 外部服务部署。先运行 sh scripts/production.sh init，再填写下列必填项。
# 不执行source .env，不提交真实.env。生产使用Kubernetes，研发使用Docker Compose V2。
COMPOSE_PROJECT_NAME=smarttitu_external
ASSISTANT_IMAGE=smarttitu-assistant:external-20261116
# 研发监听主机地址和端口；生产Pod始终监听0.0.0.0，Service转发至APP_PORT。
APP_HOST=0.0.0.0
APP_PORT=8201
APP_WORKERS=1
# 初始化自动生成，不覆盖现有非空值。
AUTH_SECRET=
OPERATIONS_TOKEN=
DEPLOYMENT_ID=

# 必填：已创建的独立业务库及拥有该库schema建表权限的账号。
# 密码中的@、:、/、#、%等字符需要URL编码；TLS要求可追加?sslmode=require。
DATABASE_URL=
# 向量服务已由基础设施配置完成，App不直连etcd、MinIO。
VECTOR_BACKEND=milvus
MILVUS_URI=
MILVUS_TOKEN=
# 如供应商分配非default数据库，请先由管理员创建并填写该名称。
MILVUS_DATABASE=default
# init自动填入唯一前缀；与原服务隔离，投入使用后不随意变更。
MILVUS_COLLECTION=
# 默认匹配研发环境；云服务若只支持自动索引，可设AUTOINDEX。
MILVUS_INDEX_TYPE=HNSW

# 三个模型均为外部API。LLM填/v1基础地址，其余两个填完整接口地址。
ANSWER_MODE=llm
RETRIEVAL_BACKEND=semantic
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_MAX_TOKENS=2048
# 默认不发送供应商特定thinking参数；原环境复制时会保留原值。
MODEL_DISABLE_THINKING=false
# 关闭思考参数格式：vllm沿用研发网关；enable_thinking适用于硅基流动支持该开关的模型；none不发送。
# 改用硅基流动Qwen3-32B时：MODEL_DISABLE_THINKING=true，MODEL_THINKING_FORMAT=enable_thinking。
MODEL_THINKING_FORMAT=vllm
EMBEDDING_PROVIDER=openai
EMBEDDING_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_REVISION=v1
RERANK_ENABLED=true
RERANK_URL=
RERANK_API_KEY=
RERANK_MODEL=
# 私有HTTP模型接口必须明确允许来源。HTTPS接口无需填写。
MODEL_HTTP_ORIGINS=
SEMANTIC_MIN_SIMILARITY=0.60
RERANK_MIN_SCORE=0.60
RAG_TOP_K=12
RAG_CONTEXT_K=3
RETRIEVAL_TIMEOUT_SECONDS=15
EMBEDDING_TIMEOUT=30
RERANK_TIMEOUT=30

ANONYMOUS_WIDGET_ENABLED=true
# init生成独立Cookie名称，防止同主机8200/8201互相覆盖身份Cookie。
ANONYMOUS_COOKIE_NAME=
# 正式HTTPS接入设true；同机HTTP测试设false。
ANONYMOUS_COOKIE_SECURE=true
# 测试同源演示页可留空；跨站嵌入填写平台origin，例如https://portal.example.com。
FRAME_ORIGINS=
CORS_ORIGINS=
SESSION_RETENTION_DAYS=7
SESSION_CONTEXT_ROUNDS=20
SESSION_IDLE_SECONDS=1800
SESSION_CLEANUP_INTERVAL_SECONDS=300
TENANT_MESSAGES_PER_MINUTE=20

# 所有用户共享的每日RAG问答上限；北京时间零点重置，常见问题直接读取不计入。修改后重新创建App/更新K8s配置。
GLOBAL_RAG_QUESTIONS_PER_DAY=1000
LOG_TIMEZONE=Asia/Shanghai
LOG_RETENTION_DAYS=30
# 完整排障日志保留7天；普通运行日志仍为30天。
LOG_DEBUG_CONTENT=true
LOG_DEBUG_RETENTION_DAYS=7
LOG_TRACE_DETAIL=compact
PDF_MEDIA_ENABLED=true
CUSTOMER_LINK_HOSTS=www.smarttitu.cn,smarttitu.cn,console.smarttitu.cn,doc.smarttitu.cn
SUPPORT_QR_URL=

# Kubernetes部署参数：先确认kubectl当前上下文；必须填写明确的上下文名称。
K8S_CONTEXT=
K8S_NAMESPACE=smarttitu
K8S_APP_NAME=titu-assistant
# 镜像必须改为公司镜像仓库的完整地址及唯一版本标签；生产不可使用latest。
# ASSISTANT_IMAGE在上方统一配置。
# PVC长期保存var/logs和var/pdf_media。空StorageClass使用集群默认值。
K8S_PVC_NAME=titu-assistant-var
K8S_STORAGE_CLASS=
K8S_STORAGE_SIZE=20Gi
# 已由平台创建PVC时设false；需保证UID/GID 10001可写。
K8S_CREATE_PVC=true
K8S_IMAGE_PULL_SECRET=
# 默认单副本；扩容前需单独评估共享存储与日志锁，不直接增加副本数。
K8S_CPU_REQUEST=500m
K8S_CPU_LIMIT=2
K8S_MEMORY_REQUEST=1Gi
K8S_MEMORY_LIMIT=4Gi
K8S_JOB_TIMEOUT=1800
