# SmartTITU 匿名客服独立部署配置。先执行 sh scripts/v3.sh init。
# 不执行 source .env；此文件由 Docker Compose 与管理程序读取。
# 密钥由 init 本地生成，不得提交真实 .env；数据库初始化后不得直接改密码。

# Compose项目名决定容器和数据卷名称；投入使用后保持不变。
COMPOSE_PROJECT_NAME=smarttitu_assistant
# 公网由HTTPS网关转发；本机HTTP联调可临时改为0.0.0.0。
V3_HOST=127.0.0.1
V3_PORT=8200
# 后端身份签名密钥。变更会使现有凭证失效、改变日志匿名标识。
AUTH_SECRET=
# 运维指标接口 X-Operations-Token，非客户访问凭证。
OPERATIONS_TOKEN=
APP_WORKERS=1

# 三个模型服务均需独立提供，本Compose不部署模型。
# MODEL_BASE_URL填基础地址，通常以/v1结尾；其他两个填完整接口URL。
ANSWER_MODE=llm
MODEL_BASE_URL=http://127.0.0.1:18080/v1
MODEL_API_KEY=
MODEL_NAME=Qwen/Qwen3-32B
# HTTP模型来源白名单：只填协议、主机、端口，逗号分隔；HTTPS不要求此项。
MODEL_HTTP_ORIGINS=http://127.0.0.1:18080,http://127.0.0.1:4001
MODEL_MAX_TOKENS=2048
# Qwen3服务需支持enable_thinking参数；不支持时改false。
MODEL_DISABLE_THINKING=true
RETRIEVAL_BACKEND=semantic
EMBEDDING_PROVIDER=openai
EMBEDDING_URL=http://127.0.0.1:4001/v1/embeddings
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=
# 权重或向量处理方式变化时更新版本并重建知识索引。
EMBEDDING_REVISION=v1
RERANK_ENABLED=true
RERANK_URL=http://127.0.0.1:4001/v1/rerank
RERANK_MODEL=Qwen3-Reranker-4B
RERANK_API_KEY=
# 召回和重排门槛不是回答准确率，应以业务问题验证校准。
SEMANTIC_MIN_SIMILARITY=0.60
RERANK_MIN_SCORE=0.60
# 每路召回最多12条；融合去重后最多24条，回答上下文最多3条。
RAG_TOP_K=12
RAG_CONTEXT_K=3
# 在线检索共享15秒预算；单接口30秒上限同时受剩余预算约束。
RETRIEVAL_TIMEOUT_SECONDS=15
EMBEDDING_TIMEOUT=30
RERANK_TIMEOUT=30

# 独立数据库；宿主机只绑定回环地址。init自动生成账号密码和连接串。
POSTGRES_USER=assistant_admin
POSTGRES_DB=ai_customer
POSTGRES_PORT=55432
POSTGRES_PASSWORD=
APP_DB_USER=assistant_runtime
APP_DB_PASSWORD=
DATABASE_URL=
# etcd、MinIO、Milvus的数据通过Compose命名卷持久化。
VECTOR_BACKEND=milvus
MILVUS_PORT=19530
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_COLLECTION=smarttitu_knowledge
MILVUS_ROOT_PASSWORD=
MINIO_ROOT_USER=assistantstorage
MINIO_ROOT_PASSWORD=
# 可替换为公司镜像仓库中的同版本镜像；改版本前单独做兼容验证。
POSTGRES_IMAGE=postgres:16.10-bookworm
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.18
MINIO_IMAGE=minio/minio:RELEASE.2024-05-28T17-19-04Z
MILVUS_IMAGE=milvusdb/milvus:v2.6.4
ASSISTANT_IMAGE=smarttitu-assistant:release-20261111

# 匿名ID由服务端生成；Token1小时，身份Cookie30天并在认证时续期。
ANONYMOUS_WIDGET_ENABLED=true
# 正式HTTPS网关接入设true；纯HTTP联调临时设false。
ANONYMOUS_COOKIE_SECURE=true
# 允许嵌入的父页面origin：协议、域名、端口，不含路径及尾斜杠，不使用*。
FRAME_ORIGINS=https://portal.example.com
# 仅宿主页面直接跨域fetch接口时配置；使用iframe脚本通常不需要。
CORS_ORIGINS=
SESSION_RETENTION_DAYS=7
SESSION_CONTEXT_ROUNDS=20
SESSION_IDLE_SECONDS=1800
SESSION_CLEANUP_INTERVAL_SECONDS=300
# 所有匿名访客共用一个默认企业，滚动60秒合计额度，非每人额度。
TENANT_MESSAGES_PER_MINUTE=20

# 普通日志30天；完整正文调试默认关闭，打开后按3天保留。
LOG_TIMEZONE=Asia/Shanghai
LOG_RETENTION_DAYS=30
LOG_DEBUG_CONTENT=false
LOG_DEBUG_RETENTION_DAYS=3
LOG_TRACE_DETAIL=compact
PDF_MEDIA_ENABLED=true
# 允许在回答中跳转的客户链接域名；知识原文下载入口保持关闭。
CUSTOMER_LINK_HOSTS=www.smarttitu.cn,smarttitu.cn,console.smarttitu.cn,doc.smarttitu.cn
# 可选人工联系二维码；没有真实二维码保持空白。
SUPPORT_QR_URL=
