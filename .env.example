# 推荐使用python3 manage.py自动读取.env；容器通过env_file读取
# AUTH_SECRET 必填,生成后只保存在可信后端;至少32字节
AUTH_SECRET=
ANSWER_MODE=extractive
# 真正模型生成时改为 llm 并配置以下参数;实际模型ID以控制台为准
MODEL_BASE_URL=https://api.smarttitu.cn/v1
MODEL_API_KEY=
MODEL_NAME=
# 逗号分隔的前端来源,本地纯接口测试可留空
CORS_ORIGINS=
# 当前未提供企业微信二维码,保持空白:界面只显示电话和邮箱
SUPPORT_QR_URL=
# 可选:原文档的受控HTTPS目录,没有时只提供已认证的知识条目链接
SOURCE_BASE_URL=
HOST=127.0.0.1
PORT=8000

# 内网HTTP模型显式允许来源(不含/v1路径),例如http://10.180.158.23:18080
MODEL_HTTP_ORIGINS=
# 知识余弦相似度最低门槛,0至1,与主题覆盖/BM25共同判断,不是准确率
RETRIEVAL_MIN_SIMILARITY=0.14
# 已登记的回复图片目录,默认data/media.json,通常无需修改
# MEDIA_PATH=
