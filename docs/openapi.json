{
  "openapi": "3.0.3",
  "info": {
    "title": "SmartTITU客服后端MVP",
    "version": "1.1.0",
    "description": "一期业务接口,配套自带悬浮组件。响应字段详见API对接说明。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "健康检查",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "未认证"
          },
          "404": {
            "description": "资源不存在"
          }
        }
      }
    },
    "/v1/bootstrap": {
      "get": {
        "summary": "初始化",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "未认证"
          },
          "404": {
            "description": "资源不存在"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/sessions": {
      "get": {
        "summary": "列出本人会话",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "未认证"
          },
          "404": {
            "description": "资源不存在"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "创建会话",
        "responses": {
          "201": {
            "description": "成功"
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "未认证"
          },
          "404": {
            "description": "资源不存在"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "context": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "page_path": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "page_title": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "product": {
                        "type": "string",
                        "maxLength": 200
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{session_id}": {
      "delete": {
        "summary": "删除会话",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "未认证"
          },
          "404": {
            "description": "资源不存在"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/sessions/{session_id}/messages": {
      "get": {
        "summary": "消息历史",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "未认证"
          },
          "404": {
            "description": "资源不存在"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "summary": "知识问答",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "未认证"
          },
          "404": {
            "description": "资源不存在"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "message",
                  "request_id"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "request_id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{8,80}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/sources/{knowledge_id}": {
      "get": {
        "summary": "查看知识来源",
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "参数错误"
          },
          "401": {
            "description": "未认证"
          },
          "404": {
            "description": "资源不存在"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "knowledge_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/documents/{document_id}/revisions/{revision}/download": {
      "get": {
        "summary": "Download authenticated document revision",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "revision",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Revision file attachment",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "可信控制台后端签发的短期HMAC凭证,非JWT"
      }
    }
  }
}
