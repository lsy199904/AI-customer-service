            "minLength": 1,
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 8,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message",
          "request_id"
        ],
        "title": "ChatBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SessionBody": {
        "properties": {
