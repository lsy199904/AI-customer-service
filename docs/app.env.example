# 空白的必填项按注释生成或向外部服务获取；已填项可沿用，涉及平台能力或网络的项仍需核对。
# 自动化脚本参数已移除，本文件供手写K8s YAML使用；无需用本文件运行production.sh。

# ==================== 一、应用运行 ====================

# 应用监听地址，固定0.0.0.0；不需要获取节点IP。
HOST=0.0.0.0

# 应用监听端口，由部署人员指定；沿用8201，Service的targetPort与此一致。
PORT=8201

# 应用进程数，沿用1；由部署人员按资源配置，不是Pod副本数。
APP_WORKERS=1

# ==================== 二、认证与部署标识 ====================

# 匿名Token签发/验证及日志身份标识计算的密钥，存K8s Secret；必须填写，首次生成一次。
# 首次生成：python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# 现有自动生成入口：sh scripts/production.sh init（调用scripts/configure_external.py，写入本地.env）。
# 手写K8s YAML不执行脚本时，运行上方Python命令；将结果存入Secret，通过secretKeyRef注入，所有Pod共用且后续不变。
AUTH_SECRET=

# 运维指标接口/metrics的访问密钥，存K8s Secret；请求头使用x-operations-token。
# 手动生成：python3 -c 'import secrets; print(secrets.token_urlsafe(32))'；不发给普通前端。
# 现有自动生成入口：sh scripts/production.sh init（scripts/configure_external.py）；与AUTH_SECRET分开生成并保持稳定。
OPERATIONS_TOKEN=

# 初始化程序识别PG数据库归属的部署标识，不是企业ID；App和初始化Job保持一致。
# 首次生成：python3 -c 'import secrets; print(secrets.token_urlsafe(24))'；同一部署后续不变。
# 现有自动生成入口：sh scripts/production.sh init（scripts/configure_external.py）；App和初始化Job使用同一值。
DEPLOYMENT_ID=

# ==================== 三、数据库——PostgreSQL（外部云服务） ====================

# PG连接串，用于知识正文、版本、会话和工作流数据；存K8s Secret。
# 从云平台/DBA获取主机、端口、业务库名、账号、密码及TLS要求；账号需目标库CREATE权限。
# 格式：postgresql://账号:URL编码密码@主机:端口/业务库名?sslmode=require；TLS参数按平台要求填写。
DATABASE_URL=

# ==================== 四、数据库——Milvus（外部云服务） ====================

# 向量检索后端类型，本方案固定milvus；这是代码选项，不是服务地址。
VECTOR_BACKEND=milvus

# Milvus连接Endpoint，由外部云平台提供，包含协议及实际端口；不填PG、etcd或MinIO地址。
MILVUS_URI=

# Milvus应用访问凭证，由外部云平台签发；存K8s Secret，须允许目标库内建集合/索引、写入及检索。
MILVUS_TOKEN=

# Milvus业务数据库名，由外部云平台分配或管理员创建；default只在平台确认使用默认库时保留。
MILVUS_DATABASE=default

# Milvus集合前缀；新生产环境首次指定，确认目标Milvus业务库内不与其他部署冲突，后续不变。
# 可手动填写smarttitu_prod，或生成：python3 -c 'import secrets; print("smarttitu_ext_"+secrets.token_hex(4))'
# 自动生成入口：sh scripts/production.sh init（scripts/configure_external.py）；实际集合名由程序附加模型指纹。
MILVUS_COLLECTION=

# 向量索引类型，向外部云平台确认；支持HNSW时沿用，平台仅支持自动索引时填AUTOINDEX。
MILVUS_INDEX_TYPE=HNSW

# ==================== 五、模型——LLM（外部API） ====================

# 回答模式：llm表示调用外部LLM生成回答；本方案固定llm，不是模型名称。
ANSWER_MODE=llm

# 外部LLM的兼容API基础地址，由供应商提供；硅基流动填https://api.siliconflow.cn/v1，不填/chat/completions。
MODEL_BASE_URL=

# 外部LLM调用密钥，从供应商控制台创建；硅基流动在API密钥页面获取，存K8s Secret。
MODEL_API_KEY=

# 外部LLM模型ID，由供应商模型清单或网关映射获取；沿用值必须被对应接口支持。
MODEL_NAME=Qwen/Qwen3-32B

# 单次模型调用默认最大输出Token，沿用2048，由维护人员设置；不是每问所有调用的总Token。
MODEL_MAX_TOKENS=2048

# 是否请求关闭模型思考：true请求关闭，false不发送关闭请求；具体格式由MODEL_THINKING_FORMAT选择。
MODEL_DISABLE_THINKING=true
# 关闭思考参数格式：vllm沿用研发网关；enable_thinking适用于硅基流动支持该开关的模型；none不发送。
# 改用硅基流动Qwen3-32B时：MODEL_DISABLE_THINKING=true，MODEL_THINKING_FORMAT=enable_thinking。
MODEL_THINKING_FORMAT=vllm

# ==================== 六、模型——Embedding/BGE（外部API） ====================

# Embedding接口协议类型；openai表示OpenAI兼容协议，不表示必须使用OpenAI厂商模型。
EMBEDDING_PROVIDER=openai

# 外部Embedding完整接口地址；硅基流动填https://api.siliconflow.cn/v1/embeddings，用于入库与问题向量化。
EMBEDDING_URL=

# 外部Embedding调用密钥，由模型供应商提供；存K8s Secret，可与LLM使用不同Key。
EMBEDDING_API_KEY=

# 外部Embedding模型ID；研发沿用bge-m3，硅基流动付费Pro档填Pro/BAAI/bge-m3（须开通对应模型）。
EMBEDDING_MODEL=bge-m3

# 本地维护的Embedding版本标记，沿用v1；实际模型版本变化时调整并重建知识向量，不从接口自动获取。
EMBEDDING_REVISION=v1

# Embedding单次接口超时，单位秒，沿用30；在线调用还受剩余检索总预算限制。
EMBEDDING_TIMEOUT=30

# ==================== 七、模型——Rerank重排（外部API） ====================

# 重排开关，true表示调用外部重排模型对候选知识排序；本方案保持启用。
RERANK_ENABLED=true

# 外部重排完整接口地址；硅基流动填https://api.siliconflow.cn/v1/rerank。
RERANK_URL=

# 外部重排调用密钥，由模型供应商提供；存K8s Secret。
RERANK_API_KEY=

# 外部重排模型ID；研发沿用Qwen3-Reranker-4B，硅基流动填Qwen/Qwen3-Reranker-4B，不填聊天模型ID。
RERANK_MODEL=Qwen3-Reranker-4B

# 重排单次接口超时，单位秒，沿用研发60；在线调用还受剩余检索总预算限制。
RERANK_TIMEOUT=60

# ==================== 八、检索与模型网络设置 ====================

# 检索模式：semantic启用现有语义/混合检索流程，本方案固定该值；不是Milvus地址。
RETRIEVAL_BACKEND=semantic

# 应用允许调用的HTTP模型来源，按三个模型URL提取协议、主机和端口，多个逗号分隔；全HTTPS可留空。
# 按实际HTTP接口填写，例如http://10.180.158.23:4001；不填旧环境无关来源，也不替代网络白名单。
MODEL_HTTP_ORIGINS=

# 知识匹配的向量相似度门槛，沿用研发0.60；由维护人员根据问答评测调整，不从供应商获取。
SEMANTIC_MIN_SIMILARITY=0.60

# 候选知识的重排分数门槛，沿用你当前研发值0；不同重排模型的分数分布不同，调整前评测。
RERANK_MIN_SCORE=0

# 检索候选数量配置，沿用12；由维护人员设置，影响召回范围及重排开销。
RAG_TOP_K=12

# 知识上下文条数配置，沿用3，由检索/证据流程使用；不得大于RAG_TOP_K。
RAG_CONTEXT_K=3

# 在线检索总预算，单位秒，沿用研发60；Embedding、召回及重排共享，正文生成另行计时。
RETRIEVAL_TIMEOUT_SECONDS=60

# ==================== 九、匿名身份与前端接入 ====================

# 匿名客服入口开关，true允许访客无需登录获取匿名凭证使用客服；保持true。
ANONYMOUS_WIDGET_ENABLED=true

# 浏览器保存匿名身份的Cookie名称，不是用户ID；可直接沿用下方值，不需要重新生成。
# 如需自定义，可填smarttitu_prod_visitor；须字母开头，仅含字母、数字和下划线，同一网站不同客服部署名称不同。
# 所有生产Pod保持同名，上线后不变；现有init脚本会在此项为空时生成独立名称（scripts/configure_external.py）。
ANONYMOUS_COOKIE_NAME=smarttitu_ext_40e7b3eaf736

# 匿名Cookie是否仅通过HTTPS发送；生产HTTPS填true，研发纯HTTP才填false。
ANONYMOUS_COOKIE_SECURE=true

# 允许嵌入客服iframe的业务页面来源，向前端负责人获取；不含路径，不支持通配符。
# 可填写多个，用英文逗号分隔，例如：https://portal.company.com,https://www.company.com
FRAME_ORIGINS=

# 允许浏览器跨域调用客服API的业务页面来源，向前端负责人获取。
# 通过JS加载iframe，且API请求均在iframe内向客服同源地址发起时，可留空。
# 业务前端直接跨域调用客服API时需填写；多个来源用英文逗号分隔，例如：https://portal.company.com,https://www.company.com
CORS_ORIGINS=

# ==================== 十、会话与限流 ====================

# 用户可见历史天数，默认7；数据库物理清理由SESSION_PURGE_AFTER_DAYS单独控制。
SESSION_RETENTION_DAYS=7

# 回答可使用的历史上下文轮数配置，沿用20；由业务方/维护人员设置，不是数据库消息总条数上限。
SESSION_CONTEXT_ROUNDS=20

# 会话空闲判断与上下文处理的时间界限，单位秒，沿用1800；不是历史保存时间。
SESSION_IDLE_SECONDS=1800

# 数据库历史清理检查间隔，单位秒，默认300；SESSION_PURGE_AFTER_DAYS=0时不删除。
SESSION_CLEANUP_INTERVAL_SECONDS=300

# 每个企业60秒内的提问额度，沿用20；匿名入口共用企业标识，所有匿名用户共享此额度，不是每人20次。
TENANT_MESSAGES_PER_MINUTE=20

# 所有用户共享的每日RAG问答上限；北京时间零点重置，常见问题直接读取不计入。修改后重新创建App/更新K8s配置。
GLOBAL_RAG_QUESTIONS_PER_DAY=1000

# ==================== 十一、日志 ====================

# 日志日期及时间使用的时区，固定Asia/Shanghai表示北京时间。
LOG_TIMEZONE=Asia/Shanghai

# 普通运行日志及摘要日志的保留天数，沿用30；由维护人员设置。
LOG_RETENTION_DAYS=30

# 完整排障内容记录开关，true保存完整问答及处理过程；按当前要求开启。
LOG_DEBUG_CONTENT=true

# 完整排障日志保留天数，按要求为7；到期在日志写入触发清理时删除，不自动转摘要。
LOG_DEBUG_RETENTION_DAYS=7

# 处理流程记录粒度，compact为当前精简格式，full为更详细诊断；沿用compact。
LOG_TRACE_DETAIL=compact

# ==================== 十二、知识图片与外链 ====================

# PDF知识图片处理开关，true在入库时启用PDF图片处理；沿用true。
PDF_MEDIA_ENABLED=true

# 客户答案允许跳转的外链域名白名单，按已审核知识链接维护；只填准确域名，不填协议或路径。
CUSTOMER_LINK_HOSTS=www.smarttitu.cn,smarttitu.cn,console.smarttitu.cn,doc.smarttitu.cn

# 人工客服二维码资源地址，由业务方提供；没有二维码时留空，文字联系方式不受影响。
SUPPORT_QR_URL=

# ==================== 十三、容器内文件路径 ====================

# 初始化读取的知识文档目录，由当前Dockerfile的COPY knowledge_sources确定；使用下方镜像内路径。
KNOWLEDGE_SOURCE_DIR=/srv/assistant/knowledge_sources

# 知识配图登记JSON路径，由镜像内data/media.json确定；不是图片目录。
MEDIA_PATH=/srv/assistant/data/media.json

# PDF提取图片写入/读取目录，使用下方固定路径；初始化Job与App共用挂载到/srv/assistant/var的PVC。
PDF_MEDIA_DIR=/srv/assistant/var/pdf_media

# 应用文件日志保存目录，使用下方固定路径；需由/srv/assistant/var的PVC持久化。
LOG_DIR=/srv/assistant/var/logs

# 未配置PG时的SQLite聊天数据库回退路径；本方案配置DATABASE_URL后使用PG，保留原等价路径即可。
DATABASE_PATH=/srv/assistant/var/assistant.db

# 未配置PG时的本地知识存储回退路径；本方案使用PG和Milvus，保留原等价路径即可。
RAG_INDEX_PATH=/srv/assistant/var/rag.sqlite3

# 本次整合新增配置
# 门户登录账号接入，默认关闭；开启后由可信门户提供 userId/userName。
WIDGET_TRUST_ACCOUNT_PARAMS=false
WIDGET_ACCOUNT_TENANT=smarttitu_portal
# 输入理解模型单次调用超时（秒），不代表整轮问答超时。
QUERY_CONTEXT_TIMEOUT_SECONDS=30
# 用户仍只能查看 SESSION_RETENTION_DAYS 范围内的历史；0 关闭数据库自动清理。
SESSION_PURGE_AFTER_DAYS=0

# 证据选择模型单次超时；仍受RETRIEVAL_TIMEOUT_SECONDS总预算约束，不控制输入理解模型。
EVIDENCE_SELECTION_TIMEOUT_SECONDS=10
